{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/resume/v1.json",
  "title": "Resume",
  "description": "Template-independent resume data. All text is plain text (no LaTeX, no Markdown); the renderer escapes it. Templates ignore fields they don't display. Length limits keep single fields inside Jake's fixed-width headings, but combinations can still overflow: the build step must also reject LaTeX 'Overfull \\hbox' warnings. Rules JSON Schema can't express, checked in code: every custom_sections id is unique and appears in section_order, and every custom id in section_order has a matching custom section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basics",
    "section_order"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^[^\\s\\\\{}%#]+@[^\\s\\\\{}%#]+$",
          "maxLength": 80
        },
        "phone": {
          "$ref": "#/$defs/text",
          "maxLength": 30
        },
        "location": {
          "$ref": "#/$defs/text",
          "maxLength": 50,
          "description": "City, region. Not shown by the Jake template."
        },
        "summary": {
          "$ref": "#/$defs/text",
          "maxLength": 500,
          "description": "Not shown by the Jake template."
        },
        "links": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "section_order": {
      "description": "Order sections appear in. Each section appears at most once. Built-in sections use their names; custom sections use their id. Templates skip sections with no content.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "enum": [
              "summary",
              "education",
              "experience",
              "projects",
              "skills"
            ]
          },
          {
            "$ref": "#/$defs/custom_id"
          }
        ]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_group"
      }
    },
    "custom_sections": {
      "description": "Sections the user (or extraction) added, e.g. Volunteer Experience, Certifications. Each one must also appear in section_order to be shown.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/custom_section"
      }
    }
  },
  "$defs": {
    "text": {
      "description": "Plain single-line text. No control characters or line breaks.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "date": {
      "description": "Date as it should appear, with abbreviated months: \"Aug. 2018\", \"Sept. 2021\", \"2021\", \"Summer 2019\", \"Present\". Max 12 characters so date ranges fit beside titles.",
      "$ref": "#/$defs/text",
      "maxLength": 12
    },
    "bullet": {
      "$ref": "#/$defs/text",
      "maxLength": 300
    },
    "url": {
      "description": "Full http(s) URL. Characters that break LaTeX links are not allowed.",
      "type": "string",
      "pattern": "^https?://[^\\s\\\\{}]+$",
      "maxLength": 200
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "label": {
          "$ref": "#/$defs/text",
          "maxLength": 50,
          "description": "Optional display text. If absent, derived from the URL (scheme, www. and trailing slash removed)."
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "school"
      ],
      "properties": {
        "school": {
          "$ref": "#/$defs/text",
          "maxLength": 60
        },
        "location": {
          "$ref": "#/$defs/text",
          "maxLength": 32
        },
        "degree": {
          "$ref": "#/$defs/text",
          "maxLength": 75
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "details": {
          "description": "Optional extras: GPA, honours, relevant coursework.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "company": {
      "description": "One employer. Several roles at the same employer go in roles, most recent first. Separate stints at the same employer that the resume lists separately stay as separate entries.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "roles"
      ],
      "properties": {
        "company": {
          "$ref": "#/$defs/text",
          "maxLength": 55
        },
        "location": {
          "$ref": "#/$defs/text",
          "maxLength": 32
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text",
          "maxLength": 55
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "bullets": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text",
          "maxLength": 40
        },
        "tech": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/text",
            "maxLength": 20
          }
        },
        "link": {
          "$ref": "#/$defs/url"
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "bullets": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "skill_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "items"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/text",
          "maxLength": 30
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/text",
            "maxLength": 40
          }
        }
      }
    },
    "custom_id": {
      "description": "Identifier for a custom section, e.g. \"custom-volunteer\". Always starts with \"custom-\" so it can never clash with a built-in section name.",
      "type": "string",
      "pattern": "^custom-[a-z0-9-]+$",
      "maxLength": 40
    },
    "custom_section": {
      "description": "A user-defined section. layout picks how it is drawn, and which list holds its content: entries -> entries, list -> items, categories -> categories. The other two lists are ignored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "layout"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/custom_id"
        },
        "title": {
          "$ref": "#/$defs/text",
          "maxLength": 40
        },
        "layout": {
          "enum": [
            "entries",
            "list",
            "categories"
          ]
        },
        "entries": {
          "description": "For layout 'entries': items shaped like a job (Volunteer Experience, Leadership).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/custom_entry"
          }
        },
        "items": {
          "description": "For layout 'list': one line each (Awards, Certifications, Publications).",
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        },
        "categories": {
          "description": "For layout 'categories': label followed by items (Spoken Languages, Coursework).",
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/skill_group"
          }
        }
      }
    },
    "custom_entry": {
      "description": "One entry in an 'entries' layout section. title is the role or name, organization is where.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text",
          "maxLength": 55
        },
        "organization": {
          "$ref": "#/$defs/text",
          "maxLength": 55
        },
        "location": {
          "$ref": "#/$defs/text",
          "maxLength": 32
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "bullets": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    }
  }
}